// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Video {
  id           String  @id @default(uuid())
  title        String
  path         String
  faceDetector String
  gazeModel    String
  frames       Frame[]
}

model Frame {
  id      String @id @default(uuid())
  videoId String
  index   Int

  dlibFaceId      String? @unique
  dlibFace        Face?   @relation("DlibFace", fields: [dlibFaceId], references: [id])
  mediapipeFaceId String? @unique
  mediapipeFace   Face?   @relation("MediapipeFace", fields: [mediapipeFaceId], references: [id])

  video      Video @relation(fields: [videoId], references: [id])
  gaze       Gaze?
  looksLabel Int? // 0 = Person is not looking at the device, 1 = Person is looking at the device, 2 = Eyes or face of the person are not visible in the image
  blinkLabel Int? // 0 = Eyes closed, 1 = Eyes open, 2 = Eyes not detectable

  @@unique([videoId, index])
}

model Face {
  id             String @id @default(uuid())
  dlibFrame      Frame? @relation("DlibFace")
  mediapipeFrame Frame? @relation("MediapipeFace")
  qualityLabel   Int? // 0 = Poor quality, 1 = Medium quality, 2 = Good quality
}

model Gaze {
  id      String @id @default(uuid())
  frame   Frame? @relation(fields: [frameId], references: [id])
  frameId String @unique
}
